# Never commit real values. This repository is public.
DATABASE_URL="postgresql://gndsf:gndsf@localhost:5432/gndsf"
DIRECT_URL="postgresql://gndsf:gndsf@localhost:5432/gndsf"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Contact form / outgoing mail (Titan)
SMTP_HOST="smtp.titan.email"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
CONTACT_EMAIL=""

