# Never commit real values. This repository is public.
DATABASE_URL="postgresql://gndsf:gndsf@localhost:5432/gndsf"
DIRECT_URL="postgresql://gndsf:gndsf@localhost:5432/gndsf"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Contact form / outgoing mail (Titan)
SMTP_HOST="smtp.titan.email"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
CONTACT_EMAIL=""

# Cloudflare R2 (e-card uploads). Photos → public bucket; ID documents and
# signed agreements → PRIVATE bucket (no public access, presigned links only).
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_PRIVATE_BUCKET_NAME=""

# in-admin mailbox (Titan): defaults are smtp/imap.titan.email
# MAIL_CRED_KEY="openssl rand -base64 32"   # encrypts stored mailbox passwords

# Local seeding only
# SEED_PASSWORD=""
# ADMIN_INITIAL_PASSWORD=""

